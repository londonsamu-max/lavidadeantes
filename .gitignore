# CREDENCIALES — nunca al repositorio.
# token.json es la llave del canal: quien lo tenga puede subir y borrar videos.
config/

# Videos renderizados y material intermedio: 15 GB que se regeneran solos.
# PERO lo que escribe el cerebro (guion, plan visual, metadata) SÍ se versiona:
# no se regenera solo, y las sesiones remotas de Claude son efímeras.
output/*/*
!output/*/guion.txt
!output/*/visuales.json
!output/*/metadata.json
!output/*/miniatura*.jpg
!output/*/timing.json
!output/*/subtitulos.srt
# los bloques para pegar en Google Flow y el mapa que recoloca sus descargas:
# los escribe el cerebro y los usa el humano desde SU navegador (Flow está
# geobloqueado en los servidores donde corre la sesión remota)
!output/*/mapa_compases.json
!output/*/bloques_flow/
!output/*/bloques_flow/*.txt

# Entorno y basura del sistema
.venv/
__pycache__/
*.pyc
.DS_Store

# Por si acaso, aunque output/ ya los cubre
*.mp4
*.mp3
# — excepto la música del canal (CC-BY): assemble.py la necesita para el montaje
!assets/music/*.mp3

# Claves de API (ElevenLabs, Pexels)
.env
